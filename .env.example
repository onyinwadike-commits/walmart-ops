# Walmart Store Operations Orchestrator - Environment Variables
# Phase 2: Multi-LLM Report Generation Engine
#
# Copy this file to .env.local and fill in your API keys
# IMPORTANT: Never commit .env.local to version control

# =============================================================================
# AI PROVIDER API KEYS
# =============================================================================

# Perplexity AI - Research Agent (Sonar Pro)
# Get your API key at: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# xAI (Grok) - Real-time Agent (grok-2-latest)
# Get your API key at: https://console.x.ai/
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google AI (Gemini) - Visual Agent (gemini-2.0-flash)
# Get your API key at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic (Claude) - Strategy Agent (claude-sonnet-4)
# Get your API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (ChatGPT) - General Agent (gpt-4o)
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek - Technical Agent (deepseek-chat)
# Get your API key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment: development | production | test
NODE_ENV=development

# Application URL (used for API routes)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# OPTIONAL: RATE LIMITING & CACHING
# =============================================================================

# Report cache TTL in milliseconds (default: 5 minutes = 300000)
# REPORT_CACHE_TTL_MS=300000

# Enable/disable mock responses when API keys are missing (default: true in dev)
# USE_MOCK_RESPONSES=true

# =============================================================================
# OPTIONAL: MONITORING & LOGGING
# =============================================================================

# Log level: debug | info | warn | error
# LOG_LEVEL=info

# Enable performance tracing
# ENABLE_TRACING=false

# =============================================================================
# NOTES
# =============================================================================
#
# 1. API Keys Security:
#    - Keep all API keys confidential
#    - Use environment-specific keys (dev vs prod)
#    - Rotate keys periodically
#
# 2. Rate Limits (approximate):
#    - Perplexity: 20 requests/min
#    - Grok: 30 requests/min
#    - Gemini: 60 requests/min
#    - Claude: 50 requests/min
#    - ChatGPT: 60 requests/min
#    - DeepSeek: 60 requests/min
#
# 3. Mock Mode:
#    - If API keys are missing in development, mock responses are used
#    - This allows testing the UI without API costs
#
# 4. Costs:
#    - Monitor your API usage through each provider's dashboard
#    - Full report generation may use 10,000-50,000 tokens
#    - Consider using caching to reduce API calls
